# Configuración de ejemplo para desarrollo local
APP_NAME=GUARDIAN-CARIBE-V1
APP_ENV=development
DATABASE_URL=sqlite:///./guardian_caribe.db
BACKUP_DIRECTORY=./backups
LOG_LEVEL=INFO
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=guardian-caribe
ACCESS_TOKEN_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12
BRUTE_FORCE_WINDOW_MINUTES=10
BRUTE_FORCE_THRESHOLD=5
ALERT_DEDUPE_MINUTES=5
RATE_LIMIT_PER_MINUTE=120
# Optional first-run administrator bootstrap. Use a unique password of 12+ characters.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-password

# Optional outbound threat-intelligence integrations. Use trusted HTTPS endpoints.
# MISP uses a dedicated read-only Auth Key; do not reuse an administrator key.
MISP_URL=
MISP_API_KEY=
MISP_PAGE_SIZE=100
MISP_MAX_PAGES=5
# TAXII 2.1 API root and collection ID. OpenCTI commonly accepts a bearer token.
TAXII_API_ROOT=
TAXII_COLLECTION_ID=
TAXII_BEARER_TOKEN=
TAXII_PAGE_SIZE=100
TAXII_MAX_PAGES=5
INTEGRATION_TIMEOUT_SECONDS=15
